{
    "name": "lenorix/datadis-client",
    "description": "PHP client for Datadis, the platform where Spanish electricity distributors publish supply data: supplies, contracts, hourly and quarter-hourly consumption, maximum power, reactive energy and public open data.",
    "keywords": [
        "datadis",
        "electricity",
        "energy",
        "consumption",
        "smart-meter",
        "cups",
        "spain",
        "psr-18",
        "api-client"
    ],
    "homepage": "https://github.com/lenorix/datadis-php-client",
    "type": "library",
    "license": "Unlicense",
    "authors": [
        {
            "name": "Jesus Hernandez",
            "email": "jesushdez@protonmail.com",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/lenorix/datadis-php-client/issues",
        "source": "https://github.com/lenorix/datadis-php-client",
        "security": "https://github.com/lenorix/datadis-php-client/security/policy"
    },
    "require": {
        "php": "^8.4",
        "ext-mbstring": "*",
        "ext-zlib": "*",
        "brick/math": "^0.14.2 || ^0.15 || ^0.16 || ^0.17 || ^0.18 || ^0.19 || ^0.20 || ^1.0",
        "guzzlehttp/guzzle": "^8.2",
        "guzzlehttp/psr7": "^3.1",
        "psr/clock": "^1.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "psr/simple-cache": "^3.0"
    },
    "require-dev": {
        "giorgiosironi/eris": "^1.1",
        "laravel/pint": "^1.32",
        "pestphp/pest": "^4.7",
        "phpdocumentor/reflection-docblock": "^5.6.3 || ^6.0",
        "phpstan/phpstan": "^2.2",
        "sebastian/recursion-context": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "Lenorix\\DatadisClient\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lenorix\\DatadisClient\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest --parallel --fail-on-warning --fail-on-risky --fail-on-deprecation",
        "test-coverage": "XDEBUG_MODE=coverage php -d memory_limit=1G vendor/bin/pest --parallel --coverage --min=100",
        "format": "vendor/bin/pint",
        "lint": "vendor/bin/pint --test",
        "phpstan": "vendor/bin/phpstan analyse src"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
