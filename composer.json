{
    "name": "lenorix/datadis-client",
    "description": "Datadis client for PHP",
    "keywords": [
        "lenorix",
        "datadis",
        "client"
    ],
    "homepage": "https://github.com/lenorix/datadis-client",
    "license": "Unlicense",
    "authors": [
        {
            "name": "Jesus Hernandez",
            "email": "jesushdez@protonmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "brick/math": "^1.0",
        "guzzlehttp/guzzle": "^8.2",
        "psr/clock": "^1.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "psr/simple-cache": "^3.0"
    },
    "require-dev": {
        "giorgiosironi/eris": "^1.1",
        "laravel/pint": "^1.0",
        "pestphp/pest": "^4.0",
        "phpstan/phpstan": "^2.2",
        "spatie/ray": "^1.28"
    },
    "autoload": {
        "psr-4": {
            "Lenorix\\DatadisClient\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lenorix\\DatadisClient\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest --fail-on-warning --fail-on-risky",
        "test-coverage": "@php -d xdebug.mode=coverage vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "pint": "vendor/bin/pint",
        "phpstan": "vendor/bin/phpstan analyse src"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
