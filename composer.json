{
    "name": "lenorix/datadis-client",
    "description": "Datadis client for PHP",
    "keywords": [
        "lenorix",
        "datadis",
        "client"
    ],
    "homepage": "https://github.com/lenorix/datadis-client",
    "license": "Unlicense",
    "authors": [
        {
            "name": "Jesus Hernandez",
            "email": "jesushdez@protonmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "pestphp/pest": "^4.0",
        "laravel/pint": "^1.0",
        "spatie/ray": "^1.28"
    },
    "autoload": {
        "psr-4": {
            "Lenorix\\DatadisClient\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lenorix\\DatadisClient\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
            "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
